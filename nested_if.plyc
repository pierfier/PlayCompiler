Func addNums( arg1, arg2, num3 ){
    add_nums = arg1 + arg2
    add_nums
}

Func fib(n){
    if n < 2
    	then 1
	else (+ (fib n - 1) (fib n - 2))
}

Func nest_if(n){
    x = (if n > 1 then 
    	    (if n == 5 then 1 else 0)
    	else -1
        )
}

